# Hosted Gemma 4 via Google Gemini API (Hacktoberfest track)
GEMMA_PROVIDER=gemini-api
GEMMA_API_KEY=replace_with_your_google_ai_studio_key
GEMMA_MODEL_ID=gemma-4-31b-it

# Optional alternative: local Ollama / OpenAI-compatible endpoint
# GEMMA_PROVIDER=ollama-local
# GEMMA_API_BASE_URL=http://localhost:11434/v1
# GEMMA_MODEL_ID=gemma4:e2b

# Gemini Google Search grounding for web-discovered branded medicine listings.
# Use a Gemini model that supports Google Search grounding (separate from Gemma).
GEMINI_SEARCH_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_SEARCH_MODEL=gemini-2.5-flash

# Gemini Google Search grounding for web-discovered branded medicine listings.
# Use a Gemini model that supports Google Search grounding (separate from Gemma).
GEMINI_SEARCH_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_SEARCH_MODEL=gemini-2.5-flash
