# Frontend API base URL
VITE_API_BASE_URL=http://localhost:8000
# Optional future integrations (server-side only; never put private keys in frontend variables)
GEMMA_PROVIDER=ollama-local
GEMMA_MODEL_ID=gemma4:e2b
GEMMA_API_KEY=
OCR_PROVIDER=
OCR_API_KEY=
MAPS_PROVIDER=
MAPS_API_KEY=

# Local Ollama Gemma 4 defaults are applied by the backend even if these remain blank.
# For local Ollama, set GEMMA_API_BASE_URL=http://localhost:11434/v1 and GEMMA_MODEL_ID=gemma4:e2b.
# Override only for another compatible endpoint; keep secrets server-side.
GEMMA_API_BASE_URL=http://localhost:11434/v1
